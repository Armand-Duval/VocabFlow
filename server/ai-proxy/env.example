# Copy to /etc/knowell-ai-proxy.env and fill in. Never commit real keys.

APP_TOKEN=replace-with-a-long-random-string
UPSTREAM_API_KEY=sk-your-deepseek-or-kimi-key
UPSTREAM_BASE=https://api.deepseek.com/v1
UPSTREAM_MODEL=deepseek-chat
DAILY_LIMIT=20
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787
DATA_DIR=/var/lib/knowell-ai-proxy
